      padding-bottom: 13px;
    }

    .start {
      font-size: 1.25rem;
    }

    .arrow {
      display: none;
    }

    .notice {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 40px;
      padding: 24px 4px;
    }
  }

.status-area {
  display: flex;
  align-items: center;
}

.status-badge {
