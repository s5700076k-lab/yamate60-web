---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="min-height:100vh;background:#05060a;color:white;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:40px;">
    <p style="letter-spacing:.3em;opacity:.5;">COMING SOON</p>

    <h1 style="font-size:clamp(3rem,10vw,6rem);margin:20px 0;">
      TIMETABLE
    </h1>

    <p style="opacity:.65;line-height:1.8;">
      公演・ライブ等のタイムテーブルを公開予定です。
    </p>

    <a href="/" style="margin-top:40px;color:white;text-decoration:none;opacity:.6;">
      ← HOMEへ戻る
    </a>
  </main>
</Layout>