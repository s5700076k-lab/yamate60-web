---

<Layout title="TIMETABLE | 山手祭 2026">
  <Navigation />

  <main>
    <section class="hero">
      <div class="hero-glow"></div>

      <p class="eyebrow">YAMATE FESTIVAL 2026</p>
      <h1>TIMETABLE</h1>
      <p class="hero-jp">タイムテーブル</p>
      <p class="lead">
        体育館公演・軽音ライブの開催時間をご確認いただけます。
      </p>
    </section>

    <section class="timetable-section">

      <div class="venue-tabs">
        <button class="venue-tab active" data-venue="体育館">体育館</button>
        <button class="venue-tab" data-venue="軽音ライブ">軽音ライブ</button>
      </div>
<div class="timeline-scroll" data-timeline-scroll>
  <div class="timeline-grid">
    <div class="timeline-corner">
      <span>TIME</span>
    </div>

    <div class="day-header" data-date="2026-10-03">
      <div class="day-header-main">
        <span class="day-number">10.03</span>
        <span class="day-name">SAT</span>
      </div>

      <div class="today-info" data-today-info>
        <span class="today-label">TODAY</span>
        <span class="current-time" data-current-time></span>
      </div>
    </div>

    <div class="day-header" data-date="2026-10-04">
      <div class="day-header-main">
        <span class="day-number">10.04</span>
        <span class="day-name">SUN</span>
      </div>

      <div class="today-info" data-today-info>
        <span class="today-label">TODAY</span>
        <span class="current-time" data-current-time></span>
      </div>
    </div>
  </div>

<div class="timeline-body" data-timeline-body>
  <div class="time-axis" aria-hidden="true">
    {['09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00'].map((time, index) => (
      <div
        class="hour-label"
        style={`top: ${index * 150}px`}
      >
        {time}
      </div>
    ))}
  </div>

  <div class="day-column" data-day-column="day1">
  <div
  class="current-time-line"
  data-current-line
  data-date="2026-10-03"
  aria-hidden="true"
>
  <span class="current-time-dot"></span>
</div>
    {schedules.day1.map((item) => (
      <a
  class="timeline-card"
  href={`/programs?open=${encodeURIComponent(getProgramGroup(item))}`}
  data-card-venue={item.venue}
  data-start={item.start}
  data-end={item.end}
  data-date="2026-10-03"
  style={`--start: ${
    ((Number(item.start.split(':')[0]) * 60 +
      Number(item.start.split(':')[1]) -
      9 * 60) /
      60) *
    150
  }px; --duration: ${Math.max(
    ((Number(item.end.split(':')[0]) * 60 +
      Number(item.end.split(':')[1]) -
      (Number(item.start.split(':')[0]) * 60 +
        Number(item.start.split(':')[1]))) /
      60) *
      150,
    52
  )}px;`}
>
        {!item.start.endsWith(':00') && (
  <span class="exact-start">{item.start}</span>
)}
        <div class="timeline-card-content">
          <div class="timeline-card-top">
            <span class="card-time">
              {item.start}–{item.end}
            </span>

            <span class="status-badge"></span>
          </div>

          <h2>{item.name}</h2>

          <span class="detail-link">DETAIL →</span>
        </div>
      </a>
    ))}
  </div>

  <div class="day-column" data-day-column="day2">
  　<div
  class="current-time-line"
  data-current-line
  data-date="2026-10-04"
  aria-hidden="true"
>
  <span class="current-time-dot"></span>
</div>
    {schedules.day2.map((item) => (
      <a
  class="timeline-card"
  href={`/programs?open=${encodeURIComponent(getProgramGroup(item))}`}
  data-card-venue={item.venue}
  data-start={item.start}
  data-end={item.end}
  data-date="2026-10-04"
  style={`--start: ${
    ((Number(item.start.split(':')[0]) * 60 +
      Number(item.start.split(':')[1]) -
      9 * 60) /
      60) *
    150
  }px; --duration: ${Math.max(
    ((Number(item.end.split(':')[0]) * 60 +
      Number(item.end.split(':')[1]) -
      (Number(item.start.split(':')[0]) * 60 +
        Number(item.start.split(':')[1]))) /
      60) *
      150,
    52
  )}px;`}
>
        {!item.start.endsWith(':00') && (
  <span class="exact-start">{item.start}</span>
)}
        <div class="timeline-card-content">
          <div class="timeline-card-top">
            <span class="card-time">
              {item.start}–{item.end}
            </span>

            <span class="status-badge"></span>
          </div>

          <h2>{item.name}</h2>

          <span class="detail-link">DETAIL →</span>
        </div>
      </a>
    ))}
  </div>
</div>
</div>

      <div class="notice">
        <span class="notice-mark">NOTICE</span>
        <div>
          <h2>体育館公演について</h2>
          <p>
            座席は自由席です。出入り口は後方の1カ所のみです。
          </p>
          <p>
            ダンス部・チアリーダー部の公演は撮影禁止となっています。
          </p>
          <p>
            体育館内は飲食禁止です。
          </p>
        </div>
      </div>
    </section>
  </main>

 <script>
  const dateTabs =
    document.querySelectorAll<HTMLButtonElement>('.date-tab');

  const venueTabs =
    document.querySelectorAll<HTMLButtonElement>('.venue-tab');

  const scheduleLists =
    document.querySelectorAll<HTMLElement>('.schedule-list');

  const cards =
  document.querySelectorAll<HTMLElement>('.timeline-card');
  let currentDay = 'day1';
  let currentVenue = '体育館';

  function updateSchedule() {
    scheduleLists.forEach((list) => {
      const isCurrentDay =
        list.dataset.schedule === currentDay;

      list.classList.toggle('active', isCurrentDay);

      if (!isCurrentDay) return;

      const listCards =
        list.querySelectorAll<HTMLElement>('.schedule-card');

      listCards.forEach((card) => {
        const venue = card.dataset.cardVenue;

        const shouldShow =
          currentVenue === 'all' ||
          venue === currentVenue;

        card.style.display = shouldShow ? '' : 'none';
      });
    });

    const timelineCards =
    document.querySelectorAll<HTMLElement>('.timeline-card');

  timelineCards.forEach((card) => {
    const venue = card.dataset.cardVenue;
    const shouldShow = venue === currentVenue;

    card.classList.toggle('is-visible', shouldShow);
  });
  }

  function updateLiveStatus() {
    cards.forEach((card) => {
      card.classList.remove('is-live', 'is-next');

      const badge =
        card.querySelector<HTMLElement>('.status-badge');

      if (badge) badge.textContent = '';
    });

    const now = new Date();

    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');

    const today = `${year}-${month}-${day}`;

    if (
      today !== '2026-10-03' &&
      today !== '2026-10-04'
    ) {
      return;
    }

    const nowMinutes =
      now.getHours() * 60 + now.getMinutes();

    const todayCards = Array.from(cards).filter(
      (card) => card.dataset.date === today
    );

    const parseMinutes = (time: string) => {
      const [hour, minute] = time.split(':').map(Number);
      return hour * 60 + minute;
    };

    // 現在公演中
    todayCards.forEach((card) => {
      const start = parseMinutes(card.dataset.start || '00:00');
      const end = parseMinutes(card.dataset.end || '00:00');

      if (
        nowMinutes >= start &&
        nowMinutes < end
      ) {
        card.classList.add('is-live');

        const badge =
          card.querySelector<HTMLElement>('.status-badge');

        if (badge) badge.textContent = 'LIVE';
      }
    });

    // 会場ごとに次の公演を探す
    ['体育館', '軽音ライブ'].forEach((venue) => {
      const futureCards = todayCards
        .filter(
          (card) =>
            card.dataset.cardVenue === venue &&
            parseMinutes(card.dataset.start || '00:00') > nowMinutes
        )
        .sort(
          (a, b) =>
            parseMinutes(a.dataset.start || '00:00') -
            parseMinutes(b.dataset.start || '00:00')
        );

      const nextCard = futureCards[0];

      if (nextCard) {
        nextCard.classList.add('is-next');

        const badge =
          nextCard.querySelector<HTMLElement>('.status-badge');

        if (badge) badge.textContent = 'NEXT';
      }
    });
  }

  dateTabs.forEach((button) => {
    button.addEventListener('click', () => {
      currentDay = button.dataset.day || 'day1';

      dateTabs.forEach((tab) =>
        tab.classList.remove('active')
      );

      button.classList.add('active');

      updateSchedule();
    });
  });

  venueTabs.forEach((button) => {
    button.addEventListener('click', () => {
      currentVenue =
        button.dataset.venue || 'all';

      venueTabs.forEach((tab) =>
        tab.classList.remove('active')
      );

      button.classList.add('active');

      updateSchedule();
    });
  });

  updateSchedule();
  updateLiveStatus();

  // 開いたままでも表示が更新される
  setInterval(updateLiveStatus, 30000);

  function updateTodayHeader() {
  const now = new Date();

  const year = now.getFullYear();
  const month = String(now.getMonth() + 1).padStart(2, '0');
  const day = String(now.getDate()).padStart(2, '0');

  const today = `${year}-${month}-${day}`;

  const dayHeaders =
    document.querySelectorAll<HTMLElement>('.day-header');

  dayHeaders.forEach((header) => {
    const isToday = header.dataset.date === today;

    header.classList.toggle('is-today', isToday);

    const time =
      header.querySelector<HTMLElement>('[data-current-time]');

    if (time && isToday) {
      time.textContent =
        `${String(now.getHours()).padStart(2, '0')}:${String(
          now.getMinutes()
        ).padStart(2, '0')}`;
    }
  });
}

updateTodayHeader();

setInterval(updateTodayHeader, 30000);
function updateCurrentTimeLine() {
  const now = new Date();

  const year = now.getFullYear();
  const month = String(now.getMonth() + 1).padStart(2, '0');
  const day = String(now.getDate()).padStart(2, '0');
  const today = `${year}-${month}-${day}`;

  const nowMinutes =
    now.getHours() * 60 + now.getMinutes();

  const startMinutes = 9 * 60;
  const endMinutes = 15 * 60 + 30;

  const lines =
    document.querySelectorAll<HTMLElement>('[data-current-line]');

  lines.forEach((line) => {
    line.classList.remove('is-active');

    const isToday = line.dataset.date === today;
    const isFestivalTime =
      nowMinutes >= startMinutes &&
      nowMinutes <= endMinutes;

    if (!isToday || !isFestivalTime) return;

    const minutesFromStart = nowMinutes - startMinutes;

    const top =
      (minutesFromStart / 60) * 150;

    line.style.top = `${top}px`;
    line.classList.add('is-active');
  });
}

updateCurrentTimeLine();

setInterval(updateCurrentTimeLine, 30000);
</script>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(42, 86, 170, 0.16),
        transparent 32rem
      ),
      #050711;
    color: #fff;
  }

  main {
    min-height: 100vh;
    overflow: hidden;
  }

  .hero {
    position: relative;
    padding: 150px 24px 70px;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    left: 50%;
    top: -200px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: rgba(80, 140, 255, 0.18);
    filter: blur(100px);
    pointer-events: none;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #8294bd;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.32em;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.9;
    letter-spacing: 0.08em;
    font-weight: 800;
  }

  .hero-jp {
    margin: 18px 0 0;
    color: #8ea7dc;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
  }

  .lead {
    max-width: 620px;
    margin: 34px auto 0;
    color: #aeb8ce;
    line-height: 1.9;
    font-size: 0.9rem;
  }

  .timetable-section {
    width: min(100% - 40px, 1000px);
    margin: 0 auto;
    padding-bottom: 120px;
  }

  .date-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 18px;
  }

  .date-tab {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    min-height: 90px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.035);
    color: #79839a;
    cursor: pointer;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .date-tab:hover {
    transform: translateY(-2px);
  }

  .date-tab.active {
    border-color: rgba(125, 166, 255, 0.65);
    background:
      linear-gradient(
        135deg,
        rgba(55, 92, 170, 0.28),
        rgba(35, 48, 88, 0.2)
      );
    color: #fff;
  }

  .date-number {
    font-size: clamp(1.5rem, 4vw, 2.3rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .date-day {
    color: #7f9fe5;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .venue-tabs {
    display: flex;
    gap: 8px;
    margin: 26px 0 30px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .venue-tabs::-webkit-scrollbar {
    display: none;
  }

  .venue-tab {
    flex: 0 0 auto;
    padding: 10px 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: transparent;
    color: #929caf;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .venue-tab.active {
    border-color: #769cf2;
    background: #769cf2;
    color: #050711;
  }

  .schedule-list {
    display: none;
  }

  .schedule-list.active {
    display: grid;
