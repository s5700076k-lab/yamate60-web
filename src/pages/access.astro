---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout>
  <Navigation />

  <main class="access-page">

    <header class="access-hero">
      <p class="page-label">YAMATE FESTIVAL 2026</p>
      <h1>ACCESS</h1>
      <p class="page-title">アクセス</p>

      <p class="page-lead">
        山手学院中学校・高等学校へのアクセスをご案内します。
        ご来場の際にご確認ください。
      </p>
    </header>


    <section class="access-content">

      <!-- SCHOOL -->
      <article class="access-block">
        <span class="number">01</span>

        <div class="access-info">
          <p class="category">YAMATE GAKUIN</p>
          <h2>山手学院中学校・高等学校</h2>

          <div class="school-card">
            <p class="address">
              〒247-0013<br />
              神奈川県横浜市栄区上郷町460
            </p>

            <a
              class="map-button"
              href="https://www.google.com/maps/search/?api=1&query=%E5%B1%B1%E6%89%8B%E5%AD%A6%E9%99%A2%E4%B8%AD%E5%AD%A6%E6%A0%A1%E9%AB%98%E7%AD%89%E5%AD%A6%E6%A0%A1"
              target="_blank"
              rel="noopener noreferrer"
            >
              GOOGLE MAPSで見る →
            </a>
          </div>
        </div>
      </article>


      <!-- TRAIN -->
      <article class="access-block">
        <span class="number">02</span>

        <div class="access-info">
          <p class="category">BY TRAIN</p>
          <h2>電車でお越しの方</h2>

          <div class="route-card">
            <p class="route-label">JR 京浜東北・根岸線</p>

            <div class="route-main">
              <span class="station">港南台駅</span>
              <span class="route-arrow">→</span>
              <span class="walk">徒歩 約12分</span>
            </div>
          </div>
        </div>
      </article>


      <!-- BUS -->
      <article class="access-block">
        <span class="number">03</span>

        <div class="access-info">
          <p class="category">BY BUS</p>
          <h2>バスでお越しの方</h2>

          <div class="bus-grid">

            <div class="route-card">
              <p class="route-label">横浜市営バス</p>

              <h3>45・111系統ほか</h3>

              <p class="bus-stop">
                「横浜女子短期大学前」下車
              </p>
            </div>


            <div class="route-card">
              <p class="route-label">神奈川中央交通バス</p>

              <h3>大船～金沢八景線ほか</h3>

              <p class="bus-stop">
                「山手学院入口」下車
              </p>
            </div>

          </div>
        </div>
      </article>

    </section>


    <div class="back-home">
      <a href="/">← HOMEへ戻る</a>
    </div>

  </main>
</Layout>


<style>

  .access-page {
    min-height: 100vh;
    color: #fff;

    background:
      radial-gradient(
        circle at 75% 0%,
        rgba(120, 140, 255, 0.13),
        transparent 35%
      ),
      #05060a;
  }


  /* =========================
     HERO
  ========================= */

  .access-hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 140px 32px 90px;
  }

  .page-label,
  .category {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    opacity: 0.5;
  }

  .access-hero h1 {
    margin: 14px 0 0;

    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .page-title {
    margin: 28px 0 0;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
  }

  .page-lead {
    max-width: 620px;
    margin-top: 22px;

    line-height: 2;
    opacity: 0.65;
  }


  /* =========================
     CONTENT
  ========================= */

  .access-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;

    border-top:
      1px solid rgba(255, 255, 255, 0.18);
  }


  .access-block {
    display: grid;

    grid-template-columns:
      80px 1fr;

    gap: 30px;

    padding: 70px 0;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.18);
  }


  .number {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    opacity: 0.35;
  }


  .access-info {
    max-width: 820px;
  }


  .access-info h2 {
    margin: 10px 0 32px;

    font-size:
      clamp(1.7rem, 3vw, 2.5rem);

    font-weight: 500;
  }


  /* =========================
     SCHOOL
  ========================= */

  .school-card {
    padding: 32px;

    border:
      1px solid rgba(255, 255, 255, 0.16);

    background:
      rgba(255, 255, 255, 0.025);
  }


  .address {
    margin: 0;

    font-size:
      clamp(1rem, 2vw, 1.2rem);

    line-height: 2;

    opacity: 0.78;
  }


  .map-button {
    display: inline-block;

    margin-top: 28px;
    padding-bottom: 7px;

    color: #fff;

    text-decoration: none;

    font-size: 0.72rem;

    letter-spacing: 0.16em;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.5);

    opacity: 0.72;

    transition:
      opacity 0.2s ease,
      border-color 0.2s ease;
  }


  .map-button:hover {
    opacity: 1;

    border-color:
      rgba(255, 255, 255, 1);
  }


  /* =========================
     ROUTE
  ========================= */

  .route-card {
    padding: 30px;

    border:
      1px solid rgba(255, 255, 255, 0.16);

    background:
      rgba(255, 255, 255, 0.025);
  }


  .route-label {
    margin: 0 0 18px;

    font-size: 0.75rem;

    letter-spacing: 0.1em;

    opacity: 0.5;
  }


  .route-main {
    display: flex;

    align-items: center;

    gap: 22px;

    flex-wrap: wrap;
  }


  .station {
    font-size:
      clamp(1.5rem, 3vw, 2.1rem);

    font-weight: 500;
  }


  .route-arrow {
    font-size: 1.1rem;
    opacity: 0.35;
  }


  .walk {
    font-size:
      clamp(1rem, 2vw, 1.25rem);

    opacity: 0.72;
  }


  /* =========================
     BUS
  ========================= */

  .bus-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 18px;
  }


  .route-card h3 {
    margin: 0 0 16px;

    font-size:
      clamp(1.15rem, 2vw, 1.5rem);

    font-weight: 500;
  }


  .bus-stop {
    margin: 0;

    line-height: 1.9;

    font-size: 0.95rem;

    opacity: 0.68;
  }


  /* =========================
     BACK HOME
  ========================= */

  .back-home {
    max-width: 1100px;

    margin: 0 auto;

    padding:
      60px 32px 100px;
  }


  .back-home a {
    color: #fff;

    text-decoration: none;

    font-size: 0.8rem;

    letter-spacing: 0.15em;

    opacity: 0.6;
  }


  .back-home a:hover {
    opacity: 1;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {

    .access-hero {
      padding:
        110px 24px 70px;
    }


    .access-hero h1 {
      font-size:
        clamp(2.7rem, 12vw, 4rem);

      overflow-wrap: anywhere;
    }


    .access-content {
      padding: 0 24px;
    }


    .access-block {
      grid-template-columns: 1fr;

      gap: 18px;

      padding: 50px 0;
    }


    .school-card,
    .route-card {
      padding: 24px;
    }


    .bus-grid {
      grid-template-columns: 1fr;
    }


    .route-main {
      gap: 12px;
    }


    .station {
      width: 100%;
    }


    .route-arrow {
      transform: rotate(90deg);

      margin-left: 4px;
    }


    .back-home {
      padding:
        50px 24px 80px;
    }

  }

</style>