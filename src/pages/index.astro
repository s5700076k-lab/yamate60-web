    const size =
      particle.size *
      (0.75 + progress * 0.35);

    particleCtx.beginPath();

    particleCtx.arc(
      currentX,
      currentY,
      size,
      0,
      Math.PI * 2
    );

    particleCtx.fillStyle =
      `rgba(255, 255, 255, ${glow})`;

    particleCtx.fill();
  }

  if (progress < 1) {
    requestAnimationFrame(animateParticles);
  } else {
    // 最後は通常文字だけを100%で残す
    particleCtx.clearRect(
      0,
      0,
      rect.width,
      rect.height
    );

    drawSolidTitle(1);

    // HTML版STELLAは使わない
    if (stellaTitle instanceof HTMLElement) {
      stellaTitle.style.opacity = '0';
    }
  }
}

// STELLAの粒集合アニメーションは毎回再生
if (stellaTitle instanceof HTMLElement) {
  stellaTitle.style.opacity = '0';
}

// 初回はオープニングに合わせて待つ
// 再訪・再読み込み時は粒演出だけすぐ再生
const particleDelay = hasSeenOpening ? 300 : 3800;

setTimeout(() => {
  startTime = performance.now();
  requestAnimationFrame(animateParticles);
}, particleDelay);
    }
  }
}

  const canvas = document.getElementById('starfield');

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');

    if (ctx) {
      let width = 0;
      let height = 0;

      const STAR_COUNT = 120;
      const stars = [];

      function resize() {
        const rect = canvas.getBoundingClientRect();

        width = rect.width;
        height = rect.height;

        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;

        ctx.setTransform(
          window.devicePixelRatio,
          0,
          0,
          window.devicePixelRatio,
          0,
          0
        );
      }

      function createStar() {
        return {
          x: (Math.random() - 0.5) * width,
          y: (Math.random() - 0.5) * height,
          z: Math.random() * width + 1
        };
      }

      function resetStar(star) {
        star.x = (Math.random() - 0.5) * width;
        star.y = (Math.random() - 0.5) * height;
        star.z = width;
      }

      function setupStars() {
        stars.length = 0;

        for (let i = 0; i < STAR_COUNT; i++) {
          stars.push(createStar());
        }
      }

      function animate() {
        ctx.clearRect(0, 0, width, height);

        const centerX = width / 2;
        const centerY = height * 0.35;

        for (const star of stars) {
          star.z -= 5;

          if (star.z <= 1) {
            resetStar(star);
          }

          const x = (star.x / star.z) * width + centerX;
          const y = (star.y / star.z) * width + centerY;

          const size = Math.max(0.4, (1 - star.z / width) * 2.5);

          if (
            x < 0 ||
            x > width ||
            y < 0 ||
            y > height
          ) {
            resetStar(star);
            continue;
          }

          ctx.beginPath();
          ctx.arc(x, y, size, 0, Math.PI * 2);

          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          ctx.fill();
        }

        requestAnimationFrame(animate);
      }

      resize();
      setupStars();
      animate();

      window.addEventListener('resize', () => {
        resize();
        setupStars();
      });
    }
  }
</script>