---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="hero" id="top">
  <!-- オープニング -->
  <div class="opening">
  <div class="opening-stars"></div>
  <div class="first-star"></div>
  </div>
  <div class="hero-title">
  <p class="eyebrow">YAMATE FESTIVAL 2026</p>
  <canvas id="stella-particles" aria-hidden="true"></canvas>
  <h1>STELLA</h1>
  <p class="subtitle">～60光年の閃光～</p>
  </div> 
    <!-- 山手学院の校舎 -->
    <img
      class="campus"
      src="/images/IMG_6266.jpeg"
      alt="山手学院の校舎"
    />

    <!-- 写真を夜っぽくする暗いレイヤー -->
    <div class="night"></div>

    <!-- 星空 -->
    <div class="stars stars-1"></div>
    <div class="stars stars-2"></div>
    <div class="stars-3">
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  <span class="rush-star"></span>
  </div>
  <canvas id="starfield"></canvas>
  <nav class="top-nav">
  <div class="desktop-nav">
    <a href="#top">HOME</a>
    <a href="/stella">STELLA</a>
    <a href="/programs">PROGRAMS</a>
    <a href="/map">MAP</a>
    <a href="/timetable">TIMETABLE</a>
    <a href="/information">INFORMATION</a>
    <a href="/attention">ATTENTION</a>
    <a href="#coming-soon">NEWS</a>
  </div>

  <div class="mobile-nav">
    <a href="#top" class="mobile-logo">YAMATE FESTIVAL</a>

    <button class="menu-button" type="button" aria-label="メニューを開く">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu">
    <a href="#top">HOME</a>
    <a href="/stella">STELLA</a>
    <a href="/programs">PROGRAMS</a>
    <a href="/map">MAP</a>
    <a href="/timetable">TIMETABLE</a>
    <a href="/information">INFORMATION</a>
    <a href="/attention">ATTENTION</a>
    <a href="#coming-soon">NEWS</a>
  </div>
</nav>
  </main>

<section class="info-section" id="information">
  <p class="section-label">INFORMATION</p>
  <h2>開催情報</h2>

  <div class="info-grid">
    <div class="info-item">
      <span>DATE</span>
      <h3>開催日時</h3>
      <p>
     2026.10.03 SAT　9:00 — 15:35<br />
     2026.10.04 SUN　9:00 — 15:15
     </p>
    </div>

   <div class="info-item payment-important">
  <span>PAYMENT</span>
  <h3>決済方法</h3>

  <p>
    生徒による飲食企画：交通系ICカードのみ<br />
    その他の飲食展示：現金
  </p>

  <p class="payment-note">
    ※Suica・PASMO等の交通系ICカードをご利用いただけます。<br />
    ※学内に交通系ICカードのチャージ機器はございません。<br />
    ご来場前に残高をご確認のうえ、十分にチャージしてお越しください。
  </p>
</div>

    <div class="info-item">
      <span>SHOES</span>
      <h3>土足での入場</h3>
      <p>土足のままご入場いただけます</p>
    </div>

    <div class="info-item">
      <span>RESERVATION</span>
      <h3>事前予約</h3>
      <p>ご来場に事前予約は必要ありません</p>
    </div>
  </div>
</section>
<section class="coming-soon-section" id="coming-soon">
  <div class="coming-soon-heading">
    <p class="section-label">NEXT UPDATE</p>
    <h2>COMING SOON</h2>
    <p class="coming-soon-lead">
      山手祭をもっと楽しむための情報を、順次公開していきます。
    </p>
  </div>

  <div class="coming-soon-grid">
    <div class="coming-soon-item">
      <span>01</span>
      <div>
        <h3>PROGRAMS</h3>
        <p>展示一覧・詳細</p>
      </div>
    </div>

    <div class="coming-soon-item">
      <span>02</span>
      <div>
        <h3>MAP</h3>
        <p>校内マップ</p>
      </div>
    </div>

    <div class="coming-soon-item">
      <span>03</span>
      <div>
        <h3>TIMETABLE</h3>
        <p>公演・ライブ等のタイムテーブル</p>
      </div>
    </div>

    <div class="coming-soon-item">
      <span>04</span>
      <div>
        <h3>PERFORMANCE</h3>
        <p>各展示の公演時間</p>
      </div>
    </div>

    <div class="coming-soon-item">
      <span>05</span>
      <div>
        <h3>CONGESTION</h3>
        <p>展示混雑状況</p>
      </div>
    </div>

    <div class="coming-soon-item">
      <span>06</span>
      <div>
        <h3>NEWS</h3>
        <p>山手祭の最新情報</p>
      </div>
    </div>

    <div class="coming-soon-item">
      <span>07</span>
      <div>
        <h3>DIGITAL PAMPHLET</h3>
        <p>デジタルパンフレット</p>
      </div>
    </div>
  </div>

  <p class="coming-soon-note">
    CONTENTS WILL BE RELEASED SEQUENTIALLY.
  </p>
</section>
</Layout>

<style>
  .opening {
    position: absolute;
    inset: 0;
    background: #000;
    z-index: 100;
    animation: opening-fade 2s ease 3.6s forwards;
  }
  @keyframes opening-fade {
  from {
    background: #000;
  }

  to {
    background: rgba(0, 0, 0, 0.45);
  }
}
  .opening-stars {
  position: absolute;
  inset: 0;
  opacity: 0;
  background-image:
    radial-gradient(circle at 15% 25%, white 0 1px, transparent 1.5px),
    radial-gradient(circle at 32% 70%, white 0 1px, transparent 1.5px),
    radial-gradient(circle at 48% 18%, white 0 1px, transparent 1.5px),
    radial-gradient(circle at 67% 63%, white 0 1px, transparent 1.5px),
    radial-gradient(circle at 82% 30%, white 0 1px, transparent 1.5px),
    radial-gradient(circle at 91% 78%, white 0 1px, transparent 1.5px),
    radial-gradient(circle at 22% 88%, white 0 1px, transparent 1.5px);
  animation: stars-awaken 2s ease-out 1.8s forwards;
}

@keyframes stars-awaken {
  from {
    opacity: 0;
  }

  to {
    opacity: 0.75;
  }
}
.first-star {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: white;
  transform: translate(-50%, -50%);
  box-shadow:
    0 0 8px white,
    0 0 20px rgba(255, 255, 255, 0.8),
    0 0 40px rgba(180, 210, 255, 0.6);
    animation: star-awaken 2.4s ease-out forwards;
}
@keyframes star-awaken {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
  }

  40% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
  }

  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background:#02040d;
  }
  .hero-title {
  position: absolute;
  inset: 0;
  z-index: 10;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
  color: white;
  pointer-events: none;
}

.hero-title .eyebrow {
  margin: 0 0 10px;
  font-size: 0.9rem;
  letter-spacing: 0.3em;
  opacity: 0.8;
}
#stella-particles {
  width: min(90vw, 900px);
  height: clamp(120px, 20vw, 220px);
  display: block;
  pointer-events: none;
}
.hero-title h1 {
  margin: 0;
  font-size: clamp(4rem, 12vw, 9rem);
  line-height: 0.9;
  letter-spacing: 0.08em;
  font-weight: 700;
  opacity: 0;
  transform: scale(0.92);
  filter: blur(10px);
  transition:
  opacity 1.6s ease,
  transform 1.6s ease,
  filter 1.6s ease;
}
  .hero-title h1.is-visible {
  opacity: 1;
  transform: scale(1);
  filter: blur(0);
}
.hero-title .subtitle {
  margin: 16px 0 0;
  font-size: clamp(1rem, 2vw, 1.4rem);
  letter-spacing: 0.18em;
  opacity: 0;
  transform: translateY(10px);
  transition:
  opacity 1.2s ease,
  transform 1.2s ease;
}
.hero-title .subtitle.is-visible {
  opacity: 1;
  transform: translateY(0);
}
.stars-3 {
  position: absolute;
  inset: 0;
  pointer-events: none;
  
  background: transparent;
  border-radius: 0;
}
.rush-star {
  position: absolute;
  left: 50%;
  top: 35%;

  width: 2px;
  height: 16px;

  border-radius: 999px;

  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0.95)
  );

  transform-origin: center;
}
.rush-star:nth-child(1) {
  --x: -34vw;
  --y: -24vh;
  --angle: -35deg;
  animation-delay: 0s;
}

.rush-star:nth-child(2) {
  --x: 32vw;
  --y: -20vh;
  --angle: 35deg;
  animation-delay: -0.9s;
}

.rush-star:nth-child(3) {
  --x: -38vw;
  --y: 30vh;
  --angle: -145deg;
  animation-delay: -1.8s;
}

.rush-star:nth-child(4) {
  --x: 36vw;
  --y: 28vh;
  --angle: 145deg;
  animation-delay: -2.7s;
}
.rush-star:nth-child(5) {
  --x: -45vw;
  --y: -8vh;
  --angle: -75deg;
  animation-delay: -0.45s;
}

.rush-star:nth-child(6) {
  --x: 44vw;
  --y: -5vh;
  --angle: 75deg;
  animation-delay: -1.35s;
}

.rush-star:nth-child(7) {
  --x: -27vw;
  --y: 38vh;
  --angle: -160deg;
  animation-delay: -2.25s;
}

.rush-star:nth-child(8) {
  --x: 25vw;
  --y: 40vh;
  --angle: 160deg;
  animation-delay: -3.15s;
}
.rush-star {
  animation: rushOut 3.6s ease-in infinite;
}

@keyframes rushOut {
  0% {
    transform:
      translate(-50%, -50%)
      translate(0, 0)
      rotate(var(--angle))
      scaleY(0.2);

    opacity: 0;
  }

  15% {
    opacity: 0.9;
  }

  100% {
    transform:
      translate(-50%, -50%)
      translate(var(--x), var(--y))
      rotate(var(--angle))
      scaleY(1.5);

    opacity: 0;
  }
}

  .campus {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;

    filter:
      brightness(0.35)
      saturate(0.7)
      contrast(1.1);

    transform: scale(1.03);
  opacity: 0;
  transition: opacity 2.2s ease;
  }
  .campus.is-visible {
  opacity: 1;
}
  @keyframes approachCampus {
  from {
    transform: scale(1.03);
  }

  to {
    transform: scale(1.10);
  }
}

  .night {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to bottom,
        rgba(2, 5, 20, 0.45) 0%,
        rgba(3, 5, 18, 0.30) 45%,
        rgba(1, 3, 12, 0.60) 100%
      );
  }

   .stars,
  .stars::before,
  .stars::after {
    position: absolute;
    content: "";
    border-radius: 50%;
    background: white;
    pointer-events: none;
  }

  /* 少し明るい星 */
  .stars-1 {
    top: 10%;
    left: 8%;
    width: 2px;
    height: 2px;

    box-shadow:
      6vw 5vh 0 0 rgba(255,255,255,0.9),
      15vw 12vh 1px 0 rgba(255,255,255,0.7),
      24vw 3vh 0 0 rgba(255,255,255,0.95),
      33vw 16vh 2px 0 rgba(210,225,255,0.8),
      43vw 7vh 0 0 rgba(255,255,255,0.65),
      52vw 19vh 1px 0 rgba(255,255,255,0.9),
      63vw 4vh 0 0 rgba(220,230,255,0.8),
      73vw 14vh 2px 0 rgba(255,255,255,0.85),
      84vw 6vh 0 0 rgba(255,255,255,0.7);

    animation: twinkleBright 3.8s ease-in-out infinite alternate;
  }

  /* 小さくて遠い星 */
  .stars-2 {
    top: 5%;
    left: 3%;
    width: 1px;
    height: 1px;
    opacity: 0.65;

    box-shadow:
      4vw 12vh 0 0 white,
      10vw 3vh 0 0 white,
      18vw 19vh 0 0 white,
      27vw 9vh 0 0 white,
      36vw 2vh 0 0 white,
      45vw 15vh 0 0 white,
      55vw 6vh 0 0 white,
      64vw 21vh 0 0 white,
      72vw 10vh 0 0 white,
      81vw 17vh 0 0 white,
      90vw 4vh 0 0 white,
      95vw 13vh 0 0 white;

    animation: twinkleSoft 5.5s ease-in-out infinite alternate;
  }

  @keyframes twinkleBright {
    0% {
      opacity: 0.45;
      filter: blur(0px);
    }

    50% {
      opacity: 1;
      filter: drop-shadow(0 0 3px rgba(220,235,255,0.9));
    }

    100% {
      opacity: 0.65;
      filter: drop-shadow(0 0 1px rgba(255,255,255,0.5));
    }
  }

  @keyframes twinkleSoft {
    from {
      opacity: 0.25;
    }

    to {
      opacity: 0.75;
    }
  }

    box-shadow:
      45px 95px white,
      130px 20px white,
      215px 130px white,
      295px 60px white,
      380px 15px white,
      465px 105px white,
      550px 70px white,
      635px 145px white,
      720px 45px white,
      805px 90px white,
      890px 30px white,
      970px 120px white;
  }
  .stars-3 {
  top: 0;
  left: 0;
  width: 3px;
  height: 3px;
  opacity: 0.9;

  box-shadow:
    12vw 18vh 2px 0 rgba(255,255,255,0.95),
    28vw 8vh 2px 0 rgba(220,235,255,0.9),
    47vw 22vh 3px 0 rgba(255,255,255,0.95),
    68vw 11vh 2px 0 rgba(225,235,255,0.9),
    86vw 20vh 3px 0 rgba(255,255,255,0.95);

  animation:
    driftStars 7s linear infinite,
    twinkleBright 2.8s ease-in-out infinite alternate;
}

@keyframes driftStars {
  from {
    transform: translateY(-2vh) scale(0.95);
  }

  to {
    transform: translateY(8vh) scale(1.08);
  }
}
#starfield {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  pointer-events: none;
}
.info-section {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 80px 24px;
  background: #050812;
  color: white;
  overflow: hidden;
}

.info-section .section-label {
  margin: 0 0 8px;
  font-size: 0.8rem;
  letter-spacing: 0.25em;
  opacity: 0.6;
}

.info-section h2 {
  margin: 0 0 40px;
  font-size: clamp(2rem, 5vw, 3.5rem);
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  width: 100%;
}

.info-item {
  box-sizing: border-box;
  min-width: 0;
  padding: 24px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.04);
}

.info-item span {
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  opacity: 0.55;
}

.info-item h3 {
  margin: 10px 0 8px;
  font-size: 1.2rem;
}

.info-item p {
  margin: 0;
  line-height: 1.8;
  opacity: 0.82;
}

@media (max-width: 700px) {
  .info-section {
    padding: 56px 18px;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }
}
.payment-important {
  border-color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.07);
}

.payment-note {
  margin-top: 14px !important;
  font-weight: 700;
  opacity: 1 !important;
}
.top-nav {
  position: fixed;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 200;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 2vw, 30px);

  width: max-content;
  max-width: calc(100vw - 32px);
  padding: 11px 22px;

  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;

  background: rgba(5, 8, 18, 0.68);
  backdrop-filter: blur(14px);
}

.top-nav a {
  color: white;
  text-decoration: none;

  font-size: clamp(0.58rem, 0.8vw, 0.75rem);
  letter-spacing: clamp(0.08em, 0.12vw, 0.18em);
  white-space: nowrap;

  opacity: 0.68;
  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}

.top-nav a:hover {
  opacity: 1;
  transform: translateY(-1px);
}

.top-nav a {
  opacity: 0.7;
}

.top-nav a:hover {
  opacity: 1;
}

.nav-logo {
  font-weight: 700;
}

/* =========================
   COMING SOON
========================= */

.coming-soon-section {
  position: relative;
  padding: 120px 6vw 140px;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(120, 140, 255, 0.12),
      transparent 42%
    ),
    #05060a;
}

.coming-soon-section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 1px;
  height: 70px;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0.7)
  );
}

.coming-soon-heading {
  max-width: 1100px;
  margin: 0 auto 64px;
}

.coming-soon-heading .section-label {
  margin-bottom: 12px;
  font-size: 0.72rem;
  letter-spacing: 0.35em;
  opacity: 0.55;
}

.coming-soon-heading h2 {
  margin: 0;
  font-size: clamp(3rem, 8vw, 7rem);
  line-height: 0.9;
  letter-spacing: 0.04em;
  font-weight: 600;
}

.coming-soon-lead {
  margin-top: 28px;
  font-size: clamp(0.9rem, 1.5vw, 1.05rem);
  line-height: 1.9;
  opacity: 0.7;
}

.coming-soon-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  max-width: 1100px;
  margin: 0 auto;
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.coming-soon-item {
  display: flex;
  gap: 24px;
  min-height: 150px;
  padding: 32px;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.coming-soon-item:nth-child(odd) {
  border-right: 1px solid rgba(255, 255, 255, 0.18);
}

.coming-soon-item > span {
  align-self: flex-start;
  padding-top: 5px;
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  opacity: 0.4;
}

.coming-soon-item h3 {
  margin: 0 0 10px;
  font-size: clamp(1.3rem, 2.4vw, 2rem);
  letter-spacing: 0.08em;
  font-weight: 500;
}

.coming-soon-item p {
  margin: 0;
  font-size: 0.85rem;
  opacity: 0.55;
}

.coming-soon-note {
  max-width: 1100px;
  margin: 28px auto 0;
  text-align: right;
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  opacity: 0.35;
}

@media (max-width: 700px) {
  .coming-soon-section {
    padding: 90px 24px 100px;
  }

  .coming-soon-heading {
    margin-bottom: 44px;
  }

  .coming-soon-grid {
    grid-template-columns: 1fr;
  }

  .coming-soon-item {
    min-height: 120px;
    padding: 26px 8px;
  }

  .coming-soon-item:nth-child(odd) {
    border-right: none;
  }

  .coming-soon-note {
    text-align: left;
    line-height: 1.8;
  }
}

/* ===== NAVIGATION ===== */

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 2vw, 30px);
}

.mobile-nav,
.mobile-menu {
  display: none;
}

/* ===== MOBILE NAVIGATION ===== */

@media (max-width: 700px) {
  .top-nav {
    top: 14px;
    left: 16px;
    right: 16px;
    width: auto;
    max-width: none;
    transform: none;
    padding: 0;
    border-radius: 18px;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-nav {
    position: relative;
    z-index: 202;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 15px 18px;
    box-sizing: border-box;
  }

  .mobile-logo {
    color: #fff;
    text-decoration: none;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    opacity: 0.8;
  }

  .menu-button {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 30px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .menu-button span {
    display: block;
    width: 100%;
    height: 1px;
    background: #fff;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .mobile-menu {
    position: fixed;
    z-index: 201;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100vw;
    height: 100vh;
    padding: 90px 32px 40px;
    box-sizing: border-box;
    background: rgba(5, 6, 10, 0.97);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  .mobile-menu a {
    padding: 11px 0;
    color: #fff;
    text-decoration: none;
    font-size: clamp(1.5rem, 7vw, 2.2rem);
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .top-nav.menu-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .top-nav.menu-open .menu-button span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .top-nav.menu-open .menu-button span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
}

</style>
<script>
  
  const topNav = document.querySelector('.top-nav');
  const menuButton = document.querySelector('.menu-button');
  const mobileMenuLinks = document.querySelectorAll('.mobile-menu a');

  menuButton?.addEventListener('click', () => {
    topNav?.classList.toggle('menu-open');

    const isOpen = topNav?.classList.contains('menu-open');
    menuButton.setAttribute(
      'aria-label',
      isOpen ? 'メニューを閉じる' : 'メニューを開く'
    );
  });

  mobileMenuLinks.forEach((link) => {
    link.addEventListener('click', () => {
      topNav?.classList.remove('menu-open');
      menuButton?.setAttribute('aria-label', 'メニューを開く');
    });
  });

  const campus = document.querySelector('.campus');


  setTimeout(() => {
    campus?.classList.add('is-visible');
  }, 2000);

const stellaTitle = document.querySelector('.hero-title h1');
const subtitle = document.querySelector('.hero-title .subtitle');

setTimeout(() => {
  stellaTitle?.classList.add('is-visible');
}, 4200);

setTimeout(() => {
  subtitle?.classList.add('is-visible');
}, 5200);
const particleCanvas = document.getElementById('stella-particles');

if (particleCanvas instanceof HTMLCanvasElement) {
  const particleCtx = particleCanvas.getContext('2d');

  if (particleCtx) {
    const rect = particleCanvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    particleCanvas.width = Math.round(rect.width * dpr);
    particleCanvas.height = Math.round(rect.height * dpr);

    particleCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // STELLAの形を読み取るための見えないcanvas
    const textCanvas = document.createElement('canvas');
    textCanvas.width = Math.max(1, Math.floor(rect.width));
    textCanvas.height = Math.max(1, Math.floor(rect.height));

    const textCtx = textCanvas.getContext('2d');

    if (textCtx) {
      const fontSize = Math.min(
        rect.width / 5.3,
        rect.height * 0.7
      );

      textCtx.fillStyle = 'white';
      textCtx.font = `700 ${fontSize}px Arial`;
      textCtx.textAlign = 'center';
      textCtx.textBaseline = 'middle';

      textCtx.fillText(
        'STELLA',
        rect.width / 2,
        rect.height / 2
      );

      const imageData = textCtx.getImageData(
        0,
        0,
        textCanvas.width,
        textCanvas.height
      );

      const data = imageData.data;
      const particles = [];

      // STELLAの形になっている場所を粒のゴール地点にする
      for (let y = 0; y < textCanvas.height; y += 4) {
        for (let x = 0; x < textCanvas.width; x += 4) {
          const index = (y * textCanvas.width + x) * 4;

          if (data[index + 3] > 128) {
            particles.push({
              x: Math.random() * rect.width,
              y: Math.random() * rect.height,
              targetX: x,
              targetY: y,
              size: Math.random() * 1.2 + 0.8
            });
          }
        }
      }

      let startTime = 0;
      const duration = 2400;

      function animateParticles(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);

        // 最初はゆっくり、後半スッと収束
        const ease = 1 - Math.pow(1 - progress, 3);

        particleCtx.clearRect(
          0,
          0,
          rect.width,
          rect.height
        );

        for (const particle of particles) {
          const currentX =
            particle.x +
            (particle.targetX - particle.x) * ease;

          const currentY =
            particle.y +
            (particle.targetY - particle.y) * ease;

          particleCtx.beginPath();
          particleCtx.arc(
            currentX,
            currentY,
            particle.size,
            0,
            Math.PI * 2
          );

          particleCtx.fillStyle =
            'rgba(255, 255, 255, 0.95)';

          particleCtx.fill();
        }

        if (progress < 1) {
          requestAnimationFrame(animateParticles);
        }
      }

      // 今のオープニングに合わせて少し待ってから集合開始
      setTimeout(() => {
  startTime = performance.now();
  requestAnimationFrame(animateParticles);
}, 1500);
    }
  }
}
  const canvas = document.getElementById('starfield');

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');

    if (ctx) {
      let width = 0;
      let height = 0;

      const STAR_COUNT = 120;
      const stars = [];

      function resize() {
        const rect = canvas.getBoundingClientRect();

        width = rect.width;
        height = rect.height;

        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;

        ctx.setTransform(
          window.devicePixelRatio,
          0,
          0,
          window.devicePixelRatio,
          0,
          0
        );
      }

      function createStar() {
        return {
          x: (Math.random() - 0.5) * width,
          y: (Math.random() - 0.5) * height,
          z: Math.random() * width + 1
        };
      }

      function resetStar(star) {
        star.x = (Math.random() - 0.5) * width;
        star.y = (Math.random() - 0.5) * height;
        star.z = width;
      }

      function setupStars() {
        stars.length = 0;

        for (let i = 0; i < STAR_COUNT; i++) {
          stars.push(createStar());
        }
      }

      function animate() {
        ctx.clearRect(0, 0, width, height);

        const centerX = width / 2;
        const centerY = height * 0.35;

        for (const star of stars) {
          star.z -= 5;

          if (star.z <= 1) {
            resetStar(star);
          }

          const x = (star.x / star.z) * width + centerX;
          const y = (star.y / star.z) * width + centerY;

          const size = Math.max(0.4, (1 - star.z / width) * 2.5);

          if (
            x < 0 ||
            x > width ||
            y < 0 ||
            y > height
          ) {
            resetStar(star);
            continue;
          }

          ctx.beginPath();
          ctx.arc(x, y, size, 0, Math.PI * 2);

          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          ctx.fill();
        }

        requestAnimationFrame(animate);
      }

      resize();
      setupStars();
      animate();

      window.addEventListener('resize', () => {
        resize();
        setupStars();
      });
    }
  }
</script>