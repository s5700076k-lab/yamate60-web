</style>
<script>

// 山手祭2026 カウントダウン
const festivalStart = new Date('2026-10-03T09:00:00+09:00');

const countdownDays = document.getElementById('countdown-days');
const countdownHours = document.getElementById('countdown-hours');
const countdownMinutes = document.getElementById('countdown-minutes');
const countdownSeconds = document.getElementById('countdown-seconds');

function updateCountdown() {
  const now = new Date();
  const remaining = festivalStart.getTime() - now.getTime();

  if (remaining <= 0) {
    if (countdownDays) countdownDays.textContent = '00';
    if (countdownHours) countdownHours.textContent = '00';
    if (countdownMinutes) countdownMinutes.textContent = '00';
    if (countdownSeconds) countdownSeconds.textContent = '00';
    return;
  }

  const days = Math.floor(
    remaining / (1000 * 60 * 60 * 24)
  );

  const hours = Math.floor(
    (remaining / (1000 * 60 * 60)) % 24
  );

  const minutes = Math.floor(
    (remaining / (1000 * 60)) % 60
  );

  const seconds = Math.floor(
    (remaining / 1000) % 60
  );

  if (countdownDays) {
    countdownDays.textContent = String(days).padStart(2, '0');
  }

  if (countdownHours) {
    countdownHours.textContent = String(hours).padStart(2, '0');
  }

  if (countdownMinutes) {
    countdownMinutes.textContent = String(minutes).padStart(2, '0');
  }

  if (countdownSeconds) {
    countdownSeconds.textContent = String(seconds).padStart(2, '0');
  }
}

updateCountdown();
setInterval(updateCountdown, 1000);

  const hasSeenOpening = sessionStorage.getItem('yamateOpeningSeen') === 'true';
  const opening = document.querySelector('.opening');

  if (hasSeenOpening) {
    opening?.classList.add('is-skipped');
  }
  const campus = document.querySelector('.campus');


  if (hasSeenOpening) {
  campus?.classList.add('is-visible');
  } else {
  setTimeout(() => {
    campus?.classList.add('is-visible');
  }, 2000);
}

const stellaTitle = document.querySelector('.hero-title h1');
const subtitle = document.querySelector('.hero-title .subtitle');



if (hasSeenOpening) {
  subtitle?.classList.add('is-visible');
  } else {
  setTimeout(() => {
    subtitle?.classList.add('is-visible');
    sessionStorage.setItem('yamateOpeningSeen', 'true');
  }, 5200);
}
await document.fonts.load('700 100px "Space Grotesk"');
const particleCanvas = document.getElementById('stella-particles');

if (particleCanvas instanceof HTMLCanvasElement) {
  const particleCtx = particleCanvas.getContext('2d');

  if (particleCtx) {
    const rect = particleCanvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    particleCanvas.width = Math.round(rect.width * dpr);
    particleCanvas.height = Math.round(rect.height * dpr);

    particleCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // STELLAの形を読み取るための見えないcanvas
    const textCanvas = document.createElement('canvas');

    textCanvas.width = Math.max(
      1,
      Math.floor(rect.width)
    );

    textCanvas.height = Math.max(
      1,
      Math.floor(rect.height)
    );

    const textCtx = textCanvas.getContext('2d');

    if (textCtx) {
     const titleStyle = stellaTitle
  ? getComputedStyle(stellaTitle)
  : null;

const fontSize = titleStyle
  ? parseFloat(titleStyle.fontSize)
  : 144;

const fontWeight = titleStyle
  ? titleStyle.fontWeight
  : '700';

const text = 'STELLA';
const letterSpacing = fontSize * 0.08;

// Canvas上で使う文字設定
textCtx.fillStyle = 'white';
textCtx.font =
  `${fontWeight} ${fontSize}px "Space Grotesk", sans-serif`;
textCtx.textBaseline = 'middle';
textCtx.textAlign = 'left';

// 各文字の幅を測る
const widths = [...text].map((char) =>
  textCtx.measureText(char).width
);

const totalWidth =
  widths.reduce((sum, width) => sum + width, 0) +
  letterSpacing * (text.length - 1);

// 粒と完成文字の両方が使う共通座標
const textStartX =
  (rect.width - totalWidth) / 2;

const textY =
  rect.height / 2;

// 見えないCanvasにSTELLAを描く
let drawX = textStartX;

for (let i = 0; i < text.length; i++) {
  textCtx.fillText(
    text[i],
    drawX,
    textY
  );

  drawX += widths[i] + letterSpacing;
}

// 描いたSTELLAから粒のゴール地点を作る
const imageData = textCtx.getImageData(
  0,
  0,
  textCanvas.width,
  textCanvas.height
);

const data = imageData.data;
const particles = [];

for (let y = 0; y < textCanvas.height; y += 4) {
  for (let x = 0; x < textCanvas.width; x += 4) {
    const index =
      (y * textCanvas.width + x) * 4;

    if (data[index + 3] > 128) {
      particles.push({
        x: Math.random() * rect.width,
        y: Math.random() * rect.height,
        targetX: x,
        targetY: y,
        size: Math.random() * 1.2 + 0.8
      });
    }
  }
}

let startTime = 0;
const duration = 2400;

function drawSolidTitle(opacity) {
  particleCtx.save();

  particleCtx.globalAlpha = opacity;
  particleCtx.fillStyle = 'white';
  particleCtx.font =
    `${fontWeight} ${fontSize}px "Space Grotesk", sans-serif`;
  particleCtx.textBaseline = 'middle';
  particleCtx.textAlign = 'left';

  let x = textStartX;

  for (let i = 0; i < text.length; i++) {
    particleCtx.fillText(
      text[i],
      x,
      textY
    );

    x += widths[i] + letterSpacing;
  }

  particleCtx.restore();
}

function animateParticles(now) {
  const elapsed = now - startTime;

  const progress = Math.min(
    elapsed / duration,
    1
  );

  // 最初はゆっくり、終盤でSTELLAへ集まる
  const ease = Math.pow(progress, 3);

  particleCtx.clearRect(
    0,
    0,
    rect.width,
    rect.height
  );

  // 終盤から完成文字を同じCanvas・同じ位置に出す
  const solidProgress =
    progress > 0.72
      ? Math.min((progress - 0.72) / 0.28, 1)
      : 0;

  if (solidProgress > 0) {
    drawSolidTitle(solidProgress);
  }

  // 完成文字が濃くなるほど粒を薄くする
  const particleOpacity =
    1 - solidProgress;

  for (const particle of particles) {
    const currentX =
      particle.x +
      (particle.targetX - particle.x) * ease;

    const currentY =
      particle.y +
      (particle.targetY - particle.y) * ease;

    const glow =
      (0.35 + progress * 0.65) *
      particleOpacity;

    const size =
      particle.size *
      (0.75 + progress * 0.35);

    particleCtx.beginPath();

    particleCtx.arc(
      currentX,
      currentY,
      size,
      0,
      Math.PI * 2
    );

    particleCtx.fillStyle =
      `rgba(255, 255, 255, ${glow})`;

    particleCtx.fill();
  }

  if (progress < 1) {
    requestAnimationFrame(animateParticles);
  } else {
    // 最後は通常文字だけを100%で残す
    particleCtx.clearRect(
      0,
      0,
      rect.width,
      rect.height
    );

    drawSolidTitle(1);

    // HTML版STELLAは使わない
    if (stellaTitle instanceof HTMLElement) {
      stellaTitle.style.opacity = '0';
    }
  }
}

// STELLAの粒集合アニメーションは毎回再生
if (stellaTitle instanceof HTMLElement) {
  stellaTitle.style.opacity = '0';
}

// 初回はオープニングに合わせて待つ
// 再訪・再読み込み時は粒演出だけすぐ再生
const particleDelay = hasSeenOpening ? 300 : 3800;

setTimeout(() => {
  startTime = performance.now();
  requestAnimationFrame(animateParticles);
}, particleDelay);
    }
  }
}

  const canvas = document.getElementById('starfield');

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');

    if (ctx) {
      let width = 0;
      let height = 0;

      const STAR_COUNT = 120;
      const stars = [];

      function resize() {
        const rect = canvas.getBoundingClientRect();

        width = rect.width;
        height = rect.height;

        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;

        ctx.setTransform(
          window.devicePixelRatio,
          0,
          0,
          window.devicePixelRatio,
          0,
          0
        );
      }

      function createStar() {
        return {
          x: (Math.random() - 0.5) * width,
          y: (Math.random() - 0.5) * height,
          z: Math.random() * width + 1
        };
      }

      function resetStar(star) {
        star.x = (Math.random() - 0.5) * width;
        star.y = (Math.random() - 0.5) * height;
        star.z = width;
      }

      function setupStars() {
        stars.length = 0;

        for (let i = 0; i < STAR_COUNT; i++) {
          stars.push(createStar());
        }
      }

      function animate() {
        ctx.clearRect(0, 0, width, height);

        const centerX = width / 2;
        const centerY = height * 0.35;

        for (const star of stars) {
          star.z -= 5;

          if (star.z <= 1) {
            resetStar(star);
          }

          const x = (star.x / star.z) * width + centerX;
          const y = (star.y / star.z) * width + centerY;

          const size = Math.max(0.4, (1 - star.z / width) * 2.5);

          if (
            x < 0 ||
            x > width ||
            y < 0 ||
            y > height
          ) {
            resetStar(star);
            continue;
          }

          ctx.beginPath();
          ctx.arc(x, y, size, 0, Math.PI * 2);

          ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          ctx.fill();
        }

        requestAnimationFrame(animate);
      }

      resize();
      setupStars();
      animate();

      window.addEventListener('resize', () => {
        resize();
        setupStars();
      });
    }
  }
</script>