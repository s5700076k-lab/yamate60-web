---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { programs } from '../data/programs';
console.log('PROGRAMS DATA:', programs);
---

<Layout>
  <Navigation />

  <main class="programs-page">
    <section class="programs-hero">
      <p class="eyebrow">YAMATE FESTIVAL 2026</p>
      <h1>PROGRAMS</h1>
      <p class="lead">企画を探す</p>
    </section>

    <section class="search-area">
      <div class="search-box">
        <span>⌕</span>
        <input
          id="program-search"
          type="search"
          placeholder="企画名・団体名から検索"
          aria-label="企画を検索"
        />
      </div>

      <div class="filters" id="category-filters">
        <button class="active" data-category="all">すべて</button>
        <button data-category="お化け屋敷">お化け屋敷</button>
        <button data-category="縁日・遊び">縁日・遊び</button>
        <button data-category="劇・ミュージカル">劇・ミュージカル</button>
        <button data-category="飲食店">飲食店</button>
        <button data-category="部活・委員会">部活・委員会</button>
        <button data-category="学年企画展示">学年企画展示</button>
        <button data-category="その他">その他</button>
      </div>
    </section>

    <section class="program-list" id="program-list">
      {
        programs.map((program) => (
          <article
            class="program-card"
            data-category={program.category}
            data-search={`${program.title} ${program.group}`}
          >
            <div class="card-top">
              <span class="category">{program.category}</span>
              <span class="group">{program.group}</span>
            </div>

            <h2>{program.title}</h2>

            <p class="description">{program.description}</p>

            <div class="card-bottom">
              <p class="place">
                <span>LOCATION</span>
                {program.building} {program.floor} {program.room}
              </p>

              <button
  class="detail-button"
  data-title={program.title}
  data-group={program.group}
  data-category={program.category}
  data-place={`${program.building} ${program.floor} ${program.room}`}
  data-description={program.description}
>
  DETAIL →
</button>
            </div>
          </article>
        ))
      }
    </section>

    <p id="no-results" class="no-results">
      条件に一致する企画がありません。
    </p>
    <div class="detail-overlay" id="detail-overlay" aria-hidden="true">
  <div class="detail-panel">
    <button
      class="detail-close"
      id="detail-close"
      aria-label="詳細を閉じる"
    >
      ×
    </button>

    <p class="detail-category" id="detail-category"></p>
    <p class="detail-group" id="detail-group"></p>

    <h2 id="detail-title"></h2>

    <p class="detail-description" id="detail-description"></p>

    <div class="detail-info">
      <p class="detail-info-label">LOCATION</p>
      <p id="detail-place"></p>
    </div>
  </div>
</div>
  </main>
</Layout>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>('#program-search');

  const cards =
    Array.from(document.querySelectorAll<HTMLElement>('.program-card'));

   const filterButtons =
  Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      '#category-filters button[data-category]'
    )
  );

  const noResults =
    document.querySelector<HTMLElement>('#no-results');

  let selectedCategory = 'all';

  function updatePrograms() {
    const keyword = searchInput?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const searchText = (card.dataset.search ?? '').toLowerCase();

      const matchesCategory =
        selectedCategory === 'all' || category === selectedCategory;

      const matchesSearch =
        keyword === '' || searchText.includes(keyword);

      const visible = matchesCategory && matchesSearch;

      card.hidden = !visible;

      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', updatePrograms);

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectedCategory = button.dataset.category ?? 'all';

      filterButtons.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');

      updatePrograms();
    });
  });
  const detailButtons =
  Array.from(document.querySelectorAll<HTMLButtonElement>('.detail-button'));

const detailOverlay =
  document.querySelector<HTMLElement>('#detail-overlay');

const detailClose =
  document.querySelector<HTMLButtonElement>('#detail-close');

const detailTitle =
  document.querySelector<HTMLElement>('#detail-title');

const detailGroup =
  document.querySelector<HTMLElement>('#detail-group');

const detailCategory =
  document.querySelector<HTMLElement>('#detail-category');

const detailDescription =
  document.querySelector<HTMLElement>('#detail-description');

const detailPlace =
  document.querySelector<HTMLElement>('#detail-place');


function closeDetail() {
  detailOverlay?.classList.remove('is-open');
  detailOverlay?.setAttribute('aria-hidden', 'true');

  document.body.style.overflow = '';
}


detailButtons.forEach((button) => {
  button.addEventListener('click', () => {
    if (detailTitle) {
      detailTitle.textContent = button.dataset.title ?? '';
    }

    if (detailGroup) {
      detailGroup.textContent = button.dataset.group ?? '';
    }

    if (detailCategory) {
      detailCategory.textContent = button.dataset.category ?? '';
    }

    if (detailDescription) {
      detailDescription.textContent = button.dataset.description ?? '';
    }

    if (detailPlace) {
      detailPlace.textContent = button.dataset.place ?? '';
    }

    detailOverlay?.classList.add('is-open');
    detailOverlay?.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';
  });
});


detailClose?.addEventListener('click', closeDetail);


detailOverlay?.addEventListener('click', (event) => {
  if (event.target === detailOverlay) {
    closeDetail();
  }
});


document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') {
    closeDetail();
  }
});
</script>

<style>
  .programs-page {
    min-height: 100vh;
    padding: 190px 6vw 100px;
    background:
      radial-gradient(circle at 50% 0%, rgba(87, 74, 150, 0.22), transparent 35%),
      #05060a;
    color: white;
  }

  .programs-hero {
    max-width: 1200px;
    margin: 0 auto 70px;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-size: 0.72rem;
    letter-spacing: 0.35em;
    opacity: 0.45;
  }

  .programs-hero h1 {
    margin: 0;
    font-size: clamp(3.8rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .lead {
    margin-top: 25px;
    font-size: 1rem;
    letter-spacing: 0.2em;
    opacity: 0.6;
  }

  .search-area {
    max-width: 1200px;
    margin: 0 auto 55px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 20px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
  }

  .search-box span {
    font-size: 1.5rem;
    opacity: 0.5;
  }

  .search-box input {
    width: 100%;
    padding: 20px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
    font: inherit;
  }

  .search-box input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
  }

  .filters button {
    padding: 10px 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: 0.25s ease;
  }

  .filters button:hover,
  .filters button.active {
    border-color: rgba(255, 255, 255, 0.7);
    background: white;
    color: #08090d;
  }

  .program-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .program-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 330px;
  padding: 26px;
  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.12);

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(130, 115, 255, 0.09),
      transparent 38%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.065),
      rgba(255, 255, 255, 0.018)
    );

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease;
}

.program-card::before {
  content: "";
  position: absolute;
  top: -80px;
  right: -80px;

  width: 170px;
  height: 170px;

  border-radius: 50%;

  background: rgba(150, 135, 255, 0.12);
  filter: blur(45px);

  opacity: 0.35;
  pointer-events: none;

  transition:
    opacity 0.35s ease,
    transform 0.35s ease;
}

.program-card:hover {
  transform: translateY(-6px);

  border-color: rgba(180, 170, 255, 0.42);

  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.28),
    0 0 30px rgba(125, 105, 255, 0.06);
}

.program-card:hover::before {
  opacity: 0.75;
  transform: scale(1.15);
}

  .program-card[hidden] {
    display: none;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .category {
    opacity: 0.55;
  }

  .group {
    opacity: 0.85;
  }

  .program-card h2 {
    margin: 35px 0 16px;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.45;
  }

  .description {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.88rem;
    line-height: 1.9;
  }

  .card-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-top: auto;
    padding-top: 35px;
  }

  .place {
    margin: 0;
    font-size: 0.85rem;
  }

  .place span {
    display: block;
    margin-bottom: 7px;
    font-size: 0.55rem;
    letter-spacing: 0.22em;
    opacity: 0.35;
  }

  .detail-button {
    border: 0;
    background: transparent;
    color: white;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    cursor: pointer;
  }

  .no-results {
    display: none;
    max-width: 1200px;
    margin: 60px auto 0;
    text-align: center;
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .program-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .programs-page {
      padding: 120px 20px 70px;
    }

    .programs-hero {
      margin-bottom: 50px;
    }

    .program-list {
      grid-template-columns: 1fr;
    }

    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 7px;
      scrollbar-width: none;
    }

    .filters::-webkit-scrollbar {
      display: none;
    }

    .filters button {
      flex: 0 0 auto;
    }

    .program-card {
      min-height: 300px;
    }
  }
  /* ===== PROGRAM DETAIL ===== */

.detail-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;

  display: flex;
  justify-content: flex-end;

  background: rgba(0, 0, 0, 0);
  backdrop-filter: blur(0);

  visibility: hidden;
  pointer-events: none;

  transition:
    background 0.35s ease,
    backdrop-filter 0.35s ease,
    visibility 0.35s;
}

.detail-overlay.is-open {
  background: rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(8px);

  visibility: visible;
  pointer-events: auto;
}

.detail-panel {
  position: relative;

  width: min(560px, 92vw);
  height: 100%;
  padding: 110px 55px 55px;

  overflow-y: auto;

  border-left: 1px solid rgba(255, 255, 255, 0.13);

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(125, 105, 255, 0.15),
      transparent 35%
    ),
    #090a0f;

  color: white;

  transform: translateX(100%);

  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.detail-overlay.is-open .detail-panel {
  transform: translateX(0);
}

.detail-close {
  position: absolute;
  top: 35px;
  right: 40px;

  width: 46px;
  height: 46px;

  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;

  background: transparent;
  color: white;

  font-size: 1.6rem;
  line-height: 1;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.detail-close:hover {
  background: white;
  color: #08090d;
  transform: rotate(90deg);
}

.detail-category {
  margin: 0 0 12px;

  font-size: 0.7rem;
  letter-spacing: 0.18em;

  color: rgba(255, 255, 255, 0.45);
}

.detail-group {
  margin: 0 0 28px;

  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.7);
}

.detail-panel h2 {
  margin: 0;

  font-size: clamp(2rem, 4vw, 3.3rem);
  line-height: 1.3;
  letter-spacing: -0.03em;
}

.detail-description {
  margin: 40px 0 0;

  font-size: 0.95rem;
  line-height: 2;

  color: rgba(255, 255, 255, 0.68);
}

.detail-info {
  margin-top: 60px;
  padding-top: 25px;

  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.detail-info p {
  margin: 0;
}

.detail-info-label {
  margin-bottom: 10px !important;

  font-size: 0.58rem;
  letter-spacing: 0.25em;

  color: rgba(255, 255, 255, 0.35);
}

#detail-place {
  font-size: 1.05rem;
  font-weight: 600;
}


/* スマホ */

@media (max-width: 600px) {
  .detail-panel {
    width: 100%;
    padding: 100px 25px 40px;
  }

  .detail-close {
    top: 25px;
    right: 25px;
  }

  .detail-panel h2 {
    font-size: 2rem;
  }

  .detail-description {
    margin-top: 30px;
  }

  .detail-info {
    margin-top: 45px;
  }
}
</style>